<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 程序集与版本信息（带版本号的可执行文件名） -->
    <Version>2.2.0</Version>
    <AssemblyName>LightBrightnessControl_V2.2</AssemblyName>
    <RootNamespace>LightBrightnessControl</RootNamespace>
    <Company>LightBrightnessControl</Company>
    <Product>Light Brightness Control</Product>
    <Description>极致轻量的 Windows 显示器亮度调节工具</Description>

    <!-- 全局化设置 -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- 应用程序图标 -->
    <ApplicationIcon>Resources\64x64.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release 编译优化 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 内嵌图标资源（单文件发布无需附带外部 .ico 文件） -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\64x64.ico" />
  </ItemGroup>

  <!-- 不引入任何第三方依赖 -->

</Project>
